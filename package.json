{
  "name": "evenform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "verify:quality": "node scripts/verify-quality.mjs",
    "verify:input-adoption": "node scripts/verify-input-adoption.mjs",
    "verify:ssr": "node scripts/verify-ssr.mjs",
    "analyze:adoption-size": "node scripts/analyze-adoption-size.mjs",
    "verify:feedback": "node scripts/verify-field-feedback.mjs",
    "verify:adoption": "node scripts/verify-adoption.mjs",
    "verify:classes": "npm run generate:cn && node --experimental-strip-types scripts/verify-class-merging.mjs",
    "generate:cn": "node scripts/build-cn.mjs",
    "prebuild": "npm run generate:cn",
    "prebuild:starter": "npm run generate:cn",
    "pretypecheck": "npm run generate:cn",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-distribution-notices.mjs dist",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "verify:ui": "node scripts/verify-ui.mjs",
    "dev:starter": "vite --open /starter.html",
    "build:starter": "tsc -b && vite build --mode starter && node scripts/finalize-starter.mjs && node scripts/write-distribution-notices.mjs dist-starter",
    "verify:refinements": "node scripts/verify-refinements.mjs",
    "preview:starter": "vite preview --outDir dist-starter",
    "verify:details": "node scripts/verify-description-list.mjs",
    "verify:navigation": "node scripts/verify-showcase-index.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "verify:palette": "node --experimental-strip-types scripts/verify-theme-palette.mjs",
    "verify:source-contracts": "node scripts/verify-source-contracts.mjs",
    "verify:chart-contracts": "node scripts/verify-chart-contracts.mjs",
    "verify:operations": "node scripts/verify-operations.mjs",
    "verify:reading-contrast": "node scripts/verify-reading-contrast.mjs",
    "verify:static": "npm run verify:navigation && npm run verify:classes && npm run verify:palette && npm run verify:adoption",
    "verify:tokens": "node scripts/verify-token-integrity.mjs",
    "verify:anchored-tooltip": "node scripts/verify-anchored-tooltip.mjs",
    "verify:control-resilience": "node scripts/verify-control-resilience.mjs",
    "verify:copy-writer": "node scripts/verify-copy-writer.mjs",
    "verify:data-media": "node scripts/verify-data-media.mjs",
    "verify:foundations": "node scripts/verify-foundations.mjs",
    "verify:input-quality": "node scripts/verify-input-quality.mjs",
    "verify:library-navigation": "node scripts/verify-library-navigation.mjs",
    "verify:library-pages": "node scripts/verify-library-pages.mjs",
    "verify:motion-review": "node scripts/verify-motion-review.mjs",
    "verify:overlay-quality": "node scripts/verify-overlay-quality.mjs",
    "verify:pattern-quality": "node scripts/verify-pattern-quality.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fullcalendar/react": "^7.1.3",
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@visactor/vchart": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.60.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-mentions-ts": "^6.0.0",
    "react-resizable-panels": "^4.14.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "description": "An opinionated, token-driven React design system built on shadcn/ui.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "keywords": [
    "react",
    "design-system",
    "shadcn-ui",
    "base-ui",
    "tailwindcss",
    "design-tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/le0tan/evenform.git"
  },
  "homepage": "https://github.com/le0tan/evenform#readme",
  "bugs": {
    "url": "https://github.com/le0tan/evenform/issues"
  }
}
